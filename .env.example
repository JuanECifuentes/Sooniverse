# ──────────────────────────────────────────────
# Sooniverse - Environment Variables (TEMPLATE)
# Copy this file to .env and fill in the real values.
# ──────────────────────────────────────────────

# Django core
SECRET_KEY=
DEBUG=True
LOCAL=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DB_NAME=workforce_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Cache (Redis)
REDIS_URL=redis://127.0.0.1:6379/1

# Email (AWS SES)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_REGION_NAME=us-east-1
AWS_SES_RETURN_PATH=

# Commercial
TRM_CONTRACTUAL=4100.0

# Django Q2
Q_CLUSTER_NAME=sooniverse-q
Q_CLUSTER_WORKERS=2
Q_CLUSTER_TIMEOUT=90
Q_CLUSTER_RECYCLER=300

# Notifications & Rate Limiting
NOTIFICACION_INTERNA_EMAIL=
RATE_LIMIT_LIMIT=3
RATE_LIMIT_WINDOW=600

# Public site URL (used to build absolute links from background tasks)
SITE_URL=http://localhost:8000

# CRM daily digest (America/Bogota local hour, 0-23)
DIGEST_HORA_LOCAL=8

# reCAPTCHA v3 (invisible) — leave empty to disable
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

